# Margadarshi AI - Environment Configuration Example
# Copy this file to .env and fill in your keys if you wish to use live Firebase & Gemini services.
# The application runs with 100% interactive demo functionality out-of-the-box even without these.

# Firebase Web App Credentials (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopmentMode-Placeholder
VITE_FIREBASE_AUTH_DOMAIN=margadarshi-ai-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=margadarshi-ai-demo
VITE_FIREBASE_STORAGE_BUCKET=margadarshi-ai-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Google Gemini AI API Key (Optional: for live LLM counselling responses)
# If empty, the verified domain counsellor knowledge engine will answer all queries accurately.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: Secure Server-Side Firebase Cloud Functions AI Endpoint Proxy
# VITE_AI_ENDPOINT=https://us-central1-margadarshi-ai-demo.cloudfunctions.net/counselChatProxy
